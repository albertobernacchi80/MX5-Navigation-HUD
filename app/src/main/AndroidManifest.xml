<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permessi minimi: nessun GPS, nessun sensore, nessun internet. Questa app non misura
         nulla e non invia nulla: legge solo il testo delle notifiche di navigazione di Google
         Maps e disegna la freccia corrispondente sullo schermo dell'auto. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application android:theme="@style/CarAppTheme" android:label="@string/app_name" android:allowBackup="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.theme" android:resource="@style/CarAppTheme" />
        <service android:name=".NavCarAppService" android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Scorciatoia (nessuna UI propria) verso le Impostazioni di sistema per concedere il
             permesso "Accesso alle notifiche", indispensabile perché l'app possa leggere le
             notifiche di navigazione di Google Maps (vedi GoogleMapsNotificationListener). -->
        <activity android:name=".NavAccessSettingsActivity" android:exported="true"
                  android:label="Attiva notifiche Google Maps - MX-5 Nav HUD" android:theme="@style/NavAccessTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servizio di sistema che legge le notifiche di navigazione di Google Maps.
             android:permission dichiara che solo il sistema può collegarsi a questo servizio
             (è il modo corretto, diverso da un <uses-permission> dell'app): l'utente deve
             comunque autorizzare l'app a mano da Impostazioni (NavAccessSettingsActivity),
             Android non lo concede con un pop-up automatico. -->
        <service android:name=".nav.GoogleMapsNotificationListener"
                  android:exported="false"
                  android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
